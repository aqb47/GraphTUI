MainMenu {
    align: center middle;
    padding: 3;
    margin: 3;
    border: round grey;
}

Button {
    margin: 1;
    width: 100%;
}

Input {
    width: 50%;
    align: center middle;
}

HelpContainer {
    border: round grey;
    padding: 1;
    margin: 2;
}

HorizontalGroup {
    align: center middle;
    margin: 1;
}

GraphInputContainer {
    border: round grey;
}

.bold {
    text-style: bold;
}

.italic {
    text-style: italic;
}

.title {
    text-style: bold;
    text-align: center;
    margin-bottom: 2;
    margin-top: 1;
}

Static {
    padding: 1;
}

#graph_output {
    border: round grey;
    margin: 0;
    padding: 0;
}